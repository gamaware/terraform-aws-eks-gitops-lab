{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "catalog-api chart values",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image",
    "replicaCount",
    "containerPort",
    "probes",
    "resources",
    "service",
    "ingress",
    "autoscaling",
    "podDisruptionBudget",
    "networkPolicy"
  ],
  "properties": {
    "global": {
      "type": "object"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "not": {
            "const": "latest"
          },
          "description": "Informational when digest is set. 'latest' is rejected."
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": {
          "enum": [
            "IfNotPresent",
            "Always"
          ]
        }
      },
      "anyOf": [
        {
          "required": [
            "digest"
          ],
          "properties": {
            "digest": {
              "minLength": 1
            }
          }
        },
        {
          "required": [
            "tag"
          ],
          "properties": {
            "tag": {
              "minLength": 1
            }
          }
        }
      ]
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "containerPort": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535,
      "description": "Non-root containers cannot bind ports below 1024."
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "readiness",
        "liveness",
        "startup"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "readiness": {
          "$ref": "#/definitions/probeTiming"
        },
        "liveness": {
          "$ref": "#/definitions/probeTiming"
        },
        "startup": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "periodSeconds",
            "failureThreshold"
          ],
          "properties": {
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests",
        "limits"
      ],
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cpu",
            "memory"
          ],
          "properties": {
            "cpu": {
              "$ref": "#/definitions/quantity"
            },
            "memory": {
              "$ref": "#/definitions/quantity"
            }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cpu",
            "memory"
          ],
          "properties": {
            "cpu": {
              "$ref": "#/definitions/quantity"
            },
            "memory": {
              "$ref": "#/definitions/quantity"
            }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port"
      ],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "host": {
          "type": "string",
          "format": "hostname"
        },
        "certificateArn": {
          "type": "string",
          "pattern": "^(arn:aws[a-z-]*:acm:[a-z0-9-]+:[0-9]{12}:certificate/[A-Za-z0-9-]+)?$"
        },
        "scheme": {
          "enum": [
            "internet-facing",
            "internal"
          ]
        },
        "groupName": {
          "type": "string",
          "pattern": "^([a-z0-9]([-a-z0-9.]{0,61}[a-z0-9])?)?$"
        },
        "inboundCidrs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$",
            "not": {
              "enum": [
                "0.0.0.0/0"
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "host",
              "certificateArn",
              "scheme"
            ],
            "properties": {
              "certificateArn": {
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              },
              "scheme": {
                "const": "internal"
              }
            },
            "required": [
              "scheme"
            ]
          },
          "then": {
            "required": [
              "inboundCidrs"
            ],
            "properties": {
              "inboundCidrs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "targetMemoryUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "definitions": {
    "quantity": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?(m|Ki|Mi|Gi)?$"
    },
    "probeTiming": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initialDelaySeconds",
        "periodSeconds",
        "failureThreshold"
      ],
      "properties": {
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
